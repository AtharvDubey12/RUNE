# Database Connections
POSTGRES_DSN=postgres://postgres:RUNEpost@localhost:5432/runedb?sslmode=disable # Change this to your actual string
REDIS_ADDR=redis://localhost:6379/0                                                      # Change this to your actual string
REDIS_PASSWORD=                                                                 # Change this to your actual password

# Engine Architecture Limits
LOCAL_QUEUE_CAPACITY=1000 # Max number of jobs RUNE Core can hold before rejecting them :: keep this value much higher than Poller Capacity
BOX_COUNT=4         # Max number of concurrent jobs being executed at any instance :: Ideally keep this value same as your vCPU count.
POLLER_CAPACITY=12  # Limits Max number of jobs in a RUNE CORE at any instance when in a cluster :: keep this 2x or 3x of BOX_COUNT

# Server Config
PORT=3000